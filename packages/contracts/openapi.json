{
  "openapi": "3.1.0",
  "info": {
    "title": "Freelas 4 Devs API",
    "version": "1.0.0",
    "description": "API da plataforma Freelas 4 Devs. Erros seguem RFC 9457 (problem+json)."
  },
  "servers": [
    {
      "url": "https://api.freelas4devs.com.br"
    },
    {
      "url": "http://localhost:3333"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Processo vivo (não verifica dependências).",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Pronto para tráfego: verifica Postgres e Redis.",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "HTTP 503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/csrf": {
      "get": {
        "operationId": "issueCsrfToken",
        "summary": "Emite o cookie CSRF (double-submit) usado pelo web em requisições mutáveis.",
        "tags": [
          "auth"
        ],
        "responses": {
          "204": {
            "description": "HTTP 204 (sem conteúdo)"
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "Cria a conta (cliente ou freelancer) e já inicia a sessão.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "HTTP 201",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Inicia sessão com e-mail e senha.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "summary": "Renova a sessão (refresh token rotativo com detecção de reuso).",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Encerra a sessão atual.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "HTTP 204 (sem conteúdo)"
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/email/verify": {
      "post": {
        "operationId": "verifyEmail",
        "summary": "Confirma o e-mail com o token enviado por e-mail.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[\\w-]{43}$"
                  }
                },
                "required": [
                  "token"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "HTTP 204 (sem conteúdo)"
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/email/resend": {
      "post": {
        "operationId": "resendEmailVerification",
        "summary": "Reenvia o e-mail de verificação.",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "202": {
            "description": "HTTP 202 (sem conteúdo)"
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/password/forgot": {
      "post": {
        "operationId": "forgotPassword",
        "summary": "Envia link de redefinição. Sempre responde 202 (não revela se o e-mail existe).",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  }
                },
                "required": [
                  "email"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "HTTP 202 (sem conteúdo)"
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/password/reset": {
      "post": {
        "operationId": "resetPassword",
        "summary": "Redefine a senha e encerra todas as sessões abertas.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[\\w-]{43}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 128
                  }
                },
                "required": [
                  "token",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "HTTP 204 (sem conteúdo)"
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/mfa/setup": {
      "post": {
        "operationId": "beginMfaSetup",
        "summary": "Gera o segredo TOTP (ainda inativo) e o conteúdo do QR code.",
        "tags": [
          "auth",
          "mfa"
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaSetupResponse"
                }
              }
            }
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/mfa/enable": {
      "post": {
        "operationId": "confirmMfaSetup",
        "summary": "Ativa o 2FA com um código do app; devolve códigos de recuperação e sessão nível 2.",
        "tags": [
          "auth",
          "mfa"
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaEnableResponse"
                }
              }
            }
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/mfa/verify": {
      "post": {
        "operationId": "completeMfaLogin",
        "summary": "Conclui o login com o código do app ou um código de recuperação.",
        "tags": [
          "auth",
          "mfa"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "challengeToken": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  },
                  "recoveryCode": {
                    "type": "string",
                    "maxLength": 20
                  }
                },
                "required": [
                  "challengeToken"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/mfa/disable": {
      "post": {
        "operationId": "disableMfa",
        "summary": "Desativa o 2FA (indisponível para administradores). Exige sessão nível 2.",
        "tags": [
          "auth",
          "mfa"
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "HTTP 204 (sem conteúdo)"
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/oauth/{provider}": {
      "get": {
        "operationId": "startOAuth",
        "summary": "Redireciona para o provedor (GitHub/Google). Navegação de página, não fetch.",
        "tags": [
          "auth",
          "oauth"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "schema": {
              "type": "string",
              "enum": [
                "github",
                "google"
              ]
            },
            "required": true
          },
          {
            "in": "query",
            "name": "role",
            "schema": {
              "description": "Papel em caso de cadastro novo.",
              "type": "string",
              "enum": [
                "CLIENT",
                "FREELANCER"
              ]
            },
            "description": "Papel em caso de cadastro novo."
          },
          {
            "in": "query",
            "name": "redirectTo",
            "schema": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^\\/(?![/\\\\])[\\w\\-./?=&%#]*$"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "HTTP 302 (sem conteúdo)"
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/oauth/{provider}/callback": {
      "get": {
        "operationId": "oauthCallback",
        "summary": "Retorno do provedor: abre a sessão (ou desafio de 2FA) e redireciona ao web.",
        "tags": [
          "auth",
          "oauth"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "schema": {
              "type": "string",
              "enum": [
                "github",
                "google"
              ]
            },
            "required": true
          },
          {
            "in": "query",
            "name": "code",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "in": "query",
            "name": "state",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          },
          {
            "in": "query",
            "name": "error",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "302": {
            "description": "HTTP 302 (sem conteúdo)"
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Usuário da sessão atual, com papéis e permissões.",
        "tags": [
          "me"
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "default": {
            "description": "Erro (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "role": {
            "type": "string",
            "enum": [
              "CLIENT",
              "FREELANCER"
            ]
          },
          "acceptTerms": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "email",
          "password",
          "displayName",
          "role",
          "acceptTerms"
        ],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false,
        "description": "Web: corpo vazio (cookie). Mobile: refreshToken."
      },
      "Liveness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "version": {
            "type": "string"
          },
          "uptimeSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "version",
          "uptimeSeconds"
        ],
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "default": "about:blank",
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "MFA_REQUIRED",
              "CSRF_FAILED",
              "NOT_FOUND",
              "CONFLICT",
              "INVALID_STATE_TRANSITION",
              "RATE_LIMITED",
              "INTERNAL_ERROR"
            ]
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Caminho do campo, ex.: \"body.title\""
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "additionalProperties": false
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "degraded"
            ]
          },
          "checks": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            }
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "authenticated"
          },
          "user": {
            "$ref": "#/components/schemas/Me"
          },
          "session": {
            "$ref": "#/components/schemas/SessionTokens"
          }
        },
        "required": [
          "status",
          "user"
        ],
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "CLIENT",
                "FREELANCER",
                "ADMIN",
                "PROJECT_MANAGER"
              ]
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "profile:client:write",
                "profile:freelancer:write",
                "files:upload",
                "admin:users:read",
                "admin:freelancers:review",
                "admin:audit:read"
              ]
            }
          },
          "mfaEnabled": {
            "type": "boolean"
          },
          "sessionAal": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "emailVerified",
          "roles",
          "permissions",
          "mfaEnabled",
          "sessionAal",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "SessionTokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Segundos"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenExpiresIn"
        ],
        "additionalProperties": false,
        "description": "Presente apenas para clientes mobile (`x-f4d-client: mobile`)."
      },
      "LoginResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AuthResponse"
          },
          {
            "$ref": "#/components/schemas/MfaChallengeResponse"
          }
        ],
        "type": "object",
        "discriminator": {
          "propertyName": "status",
          "mapping": {
            "authenticated": "#/components/schemas/AuthResponse",
            "mfa_required": "#/components/schemas/MfaChallengeResponse"
          }
        }
      },
      "MfaChallengeResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "mfa_required"
          },
          "challengeToken": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "status",
          "challengeToken",
          "expiresInSeconds"
        ],
        "additionalProperties": false,
        "description": "Senha correta; conclua em POST /v1/auth/mfa/verify com o código do app."
      },
      "MfaSetupResponse": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Para digitar manualmente no app, se não der para ler o QR code."
          },
          "otpauthUrl": {
            "type": "string",
            "description": "Conteúdo do QR code."
          }
        },
        "required": [
          "secret",
          "otpauthUrl"
        ],
        "additionalProperties": false
      },
      "MfaEnableResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "authenticated"
          },
          "user": {
            "$ref": "#/components/schemas/Me"
          },
          "session": {
            "$ref": "#/components/schemas/SessionTokens"
          },
          "recoveryCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Exibidos uma única vez. Guarde em local seguro."
          }
        },
        "required": [
          "status",
          "user",
          "recoveryCodes"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-f4d_at"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
