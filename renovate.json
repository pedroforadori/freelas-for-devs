{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "group:monorepos"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "dependências (minor/patch)"
    },
    { "matchPackageNames": ["@nestjs/**"], "groupName": "nestjs" },
    {
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "eslint-config-next",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "next + react"
    },
    { "matchPackageNames": ["drizzle-orm", "drizzle-kit"], "groupName": "drizzle" }
  ]
}
