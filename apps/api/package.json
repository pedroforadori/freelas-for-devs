{
  "name": "@f4d/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --project e2e",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:studio": "drizzle-kit studio",
    "keys:generate": "node src/scripts/generate-keys.ts",
    "admin:provision": "node dist/scripts/provision-admin.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@f4d/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/nestjs": "^11.5.0",
    "arctic": "^3.7.0",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^5.8.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.0.16",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@f4d/config-eslint": "workspace:*",
    "@f4d/config-typescript": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.0",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "catalog:"
  }
