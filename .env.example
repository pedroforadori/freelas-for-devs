# Copie para apps/api/.env e ajuste. Nunca commite arquivos .env reais.

# --- API (apps/api) ---
NODE_ENV=development
APP_VERSION=0.0.0-dev
PORT=3333
LOG_LEVEL=debug
DATABASE_URL=postgres://f4d:f4d@localhost:5432/f4d
# Usuário com permissão de DDL, usado só pelo release job de migrações.
MIGRATION_DATABASE_URL=postgres://f4d:f4d@localhost:5432/f4d
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
# Web (3000) e landing (3001, formulário da lista de espera).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_PER_MINUTE=120
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
WEB_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3333

# Login social (opcional). Callback: <API_PUBLIC_URL>/v1/auth/oauth/<github|google>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Autenticação — gere as chaves com: pnpm --filter @f4d/api keys:generate
# Sem chave, a API usa uma efêmera (sessões caem a cada restart). Obrigatória em produção.
JWT_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PREVIOUS_PUBLIC_KEYS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Em localhost via http use false; em produção true (obrigatório).
COOKIE_SECURE=false
# Produção: .freelas4devs.com.br (o web lê o cookie CSRF emitido pela API)
COOKIE_DOMAIN=

# Cifra de campos sensíveis (segredo do 2FA etc.): openssl rand -base64 32
# Sem chave, usa uma chave de desenvolvimento. Obrigatória em produção.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_ID=k1
FIELD_ENCRYPTION_PREVIOUS_KEYS=

# Storage (RustFS local do docker-compose, compatível com S3; produção: Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=f4d
S3_SECRET_ACCESS_KEY=f4d-local-secret
S3_BUCKET_QUARANTINE=f4d-quarantine
S3_BUCKET_FILES=f4d-files
S3_FORCE_PATH_STYLE=true
# Produção (R2): o browser envia direto ao bucket de quarentena — configure CORS nele
# (AllowedOrigins: URL do apps/web; AllowedMethods: PUT; AllowedHeaders: content-type).

# Antivírus dos uploads: clamav (docker-compose) | disabled (só dev; obrigatório clamav em produção)
MALWARE_SCAN=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Cloudflare Turnstile (anti-bot da lista de espera). Obrigatório em produção.
TURNSTILE_SECRET_KEY=

# Estimativa dos projetos: heuristic (dev, sem IA) | gemini (produção) | anthropic (alternativa)
ESTIMATOR=heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Pagamentos (F6): fake (dev, simula checkout) | stripe (obrigatório em produção)
PAYMENTS_PROVIDER=fake
# Chaves de TESTE do Stripe (sk_test_...) e o segredo do webhook (whsec_..., da Stripe CLI ou do painel)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Meios de pagamento do checkout, conforme habilitados na conta: card | card,pix
STRIPE_PAYMENT_METHODS=card

# E-mail: log (dev, só registra) | smtp (Mailpit: smtp://localhost:1025) | resend (produção)
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
MAIL_FROM="Freelas 4 Devs <nao-responda@freelas4devs.com.br>"

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:3333
# Site público (landing), onde ficam termos e privacidade.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Landing (apps/landing/.env.local) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333
# "true" só em produção: previews e staging nunca são indexados.
NEXT_PUBLIC_ALLOW_INDEXING=false
# false = CTAs levam à lista de espera; true = ao cadastro no app (lançamento).
NEXT_PUBLIC_APP_LIVE=false
NEXT_PUBLIC_CONTACT_EMAIL=contato@freelas4devs.com.br
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Analytics sem cookies (Plausible). Vazio = desligado.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
