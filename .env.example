# Copie para apps/api/.env e ajuste. Nunca commite arquivos .env reais.

# --- API (apps/api) ---
NODE_ENV=development
APP_VERSION=0.0.0-dev
PORT=3333
LOG_LEVEL=debug
DATABASE_URL=postgres://f4d:f4d@localhost:5432/f4d
# Usuário com permissão de DDL, usado só pelo release job de migrações.
MIGRATION_DATABASE_URL=postgres://f4d:f4d@localhost:5432/f4d
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
WEB_APP_URL=http://localhost:3000

# Autenticação — gere as chaves com: pnpm --filter @f4d/api keys:generate
# Sem chave, a API usa uma efêmera (sessões caem a cada restart). Obrigatória em produção.
JWT_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PREVIOUS_PUBLIC_KEYS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Em localhost via http use false; em produção true (obrigatório).
COOKIE_SECURE=false
# Produção: .freelas4devs.com.br (o web lê o cookie CSRF emitido pela API)
COOKIE_DOMAIN=

# E-mail: log (dev, só registra) | smtp (Mailpit: smtp://localhost:1025) | resend (produção)
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
MAIL_FROM="Freelas 4 Devs <nao-responda@freelas4devs.com.br>"

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:3333

# --- Landing (apps/landing/.env.local) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false
